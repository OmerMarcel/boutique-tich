# Configuration Serveur
PORT=5000

# Générez une valeur aléatoire d'au moins 32 caractères
JWT_SECRET=

# Identifiants de connexion administrateur
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Origines frontend autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Durée de session admin (ex: 7d, 24h)
ADMIN_SESSION_TTL=7d

# Supabase Cloud (PostgreSQL)
# Créez votre projet sur https://supabase.com puis copiez depuis :
# Project Settings > API > Project URL & anon / service_role API key
SUPABASE_URL=
SUPABASE_KEY=
# Obligatoire pour les uploads persistants (ne jamais exposer cette clé au frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Nom d'un bucket Supabase Storage public
SUPABASE_STORAGE_BUCKET=product-images
