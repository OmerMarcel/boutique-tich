{
  "cleanUrls": true,
  "outputDirectory": "client",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://boutique-tich.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://boutique-tich.onrender.com/uploads/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
